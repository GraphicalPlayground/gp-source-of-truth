# Copy this file to .env and adjust the values, then run `npm run run`.

# The directory of the target repository being synced. Point this at any local
# checkout (or scratch directory) that contains a source-of-truth configuration file.
TARGET_DIR=target-repository

# The target repository, as "owner/repo". Only used to fill in {{ github.repo.owner }} /
# {{ github.repo.repo }} in templates -- no network access is made to it locally.
TARGET_REPOSITORY=GraphicalPlayground/example-repo

# Path to the configuration file, relative to TARGET_DIR. Defaults to
# ".github/source-of-truth.yml" if unset.
# CONFIGURATION_FILE=.github/source-of-truth.yml
