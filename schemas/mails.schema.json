{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Mails Configuration Schema",
  "type": "object",
  "properties": {
    "$schema": {
      "type": "string",
      "description": "URL to the JSON schema for this configuration"
    },
    "organization": {
      "type": "object",
      "propertyNames": {
        "enum": [
          "support",
          "contact",
          "security",
          "marketing",
          "legal",
          "sponsor",
          "press",
          "billing",
          "feedback",
          "partnerships",
          "accessibility",
          "abuse",
          "careers",
          "privacy"
        ]
      },
      "additionalProperties": {
        "type": "string",
        "format": "email"
      },
      "required": [
        "support",
        "contact",
        "security",
        "marketing",
        "legal",
        "sponsor",
        "press",
        "billing",
        "feedback",
        "partnerships",
        "accessibility",
        "abuse",
        "careers",
        "privacy"
      ]
    },
    "maintainers": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string",
            "description": "The name of the maintainer"
          },
          "pseudo": {
            "type": "string",
            "description": "The pseudonym of the maintainer"
          },
          "emails": {
            "type": "array",
            "items": {
              "type": "string",
              "format": "email",
              "description": "The email address of the maintainer"
            }
          }
        },
        "required": ["pseudo", "name", "emails"],
        "additionalProperties": false
      }
    }
  },
  "required": ["organization", "maintainers"],
  "additionalProperties": false
}
