{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Funding Configuration Schema",
  "type": "object",
  "properties": {
    "$schema": {
      "type": "string",
      "description": "URL to the JSON schema for this configuration"
    },
    "community_bridge": {
      "type": "string",
      "description": "LFX Mentorship (formerly CommunityBridge) project name"
    },
    "github": {
      "description": "GitHub Sponsors username or list of usernames (max 4)",
      "oneOf": [
        {
          "type": "string"
        },
        {
          "type": "array",
          "items": {
            "type": "string"
          },
          "maxItems": 4
        }
      ]
    },
    "issuehunt": {
      "type": "string",
      "description": "IssueHunt username"
    },
    "ko_fi": {
      "type": "string",
      "description": "Ko-fi username"
    },
    "liberapay": {
      "type": "string",
      "description": "Liberapay username"
    },
    "open_collective": {
      "type": "string",
      "description": "Open Collective username"
    },
    "patreon": {
      "type": "string",
      "description": "Patreon username"
    },
    "tidelift": {
      "type": "string",
      "description": "Tidelift platform-name/package-name"
    },
    "polar": {
      "type": "string",
      "description": "Polar username"
    },
    "buy_me_a_coffee": {
      "type": "string",
      "description": "Buy Me a Coffee username"
    },
    "thanks_dev": {
      "type": "string",
      "description": "thanks.dev username starting with u/gh/",
      "pattern": "^u/gh/[a-zA-Z0-9_-]+$"
    },
    "custom": {
      "description": "Custom link or list of custom links (max 4)",
      "oneOf": [
        {
          "type": "string"
        },
        {
          "type": "array",
          "items": {
            "type": "string"
          },
          "maxItems": 4
        }
      ]
    }
  },
  "additionalProperties": false
}
