name: Synchronize Source of Truth

on:
  schedule:
    - cron: '0 0 * * *'
  workflow_dispatch:

jobs:
  synchronize:
    runs-on: ubuntu-latest
    permissions:
      contents: write
      pull-requests: write
    steps:
      - name: Create GitHub App Token
        uses: actions/create-github-app-token@v3
        id: app-token
        with:
          client-id: {{github "secrets.BOT_CLIENT_ID" }}
          private-key: {{github "secrets.BOT_PRIVATE_KEY" }}
          owner: {{github "github.repository_owner" }}
          repositories: {{github "github.event.repository.name" }},gp-source-of-truth

      - name: Get GitHub App User ID
        id: get-user-id
        run: echo "user-id=$(gh api "/users/{{github "steps.app-token.outputs.app-slug" }}[bot]" --jq .id)" >> "$GITHUB_OUTPUT"
        env:
          GH_TOKEN: {{github "steps.app-token.outputs.token" }}

      - name: Synchronize Source of Truth
        uses: GraphicalPlayground/gp-source-of-truth@ms/new-template-system
        with:
          source-repository: 'GraphicalPlayground/gp-source-of-truth'
          source-branch: 'ms/new-template-system'
          source-token: {{github "steps.app-token.outputs.token" }}
          target-repository: {{github "github.repository" }}
          target-branch: 'main'
          target-token: {{github "steps.app-token.outputs.token" }}
          bot-name: '{{github "steps.app-token.outputs.app-slug" }}[bot]'
          bot-email: '{{github "steps.get-user-id.outputs.user-id" }}+{{github "steps.app-token.outputs.app-slug" }}[bot]@users.noreply.github.com'
